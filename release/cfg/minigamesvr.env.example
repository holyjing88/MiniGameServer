# Process env for minigamesvr (EnvironmentFile for systemd / ctl scripts).
# Quote values that contain shell metacharacters (() ? &).

RANK_HTTP_ADDR=:8000
RANK_GRPC_ADDR=:8001
RANK_STORE=mysql
RANK_MYSQL_DSN="root:jgyjgyjgy@tcp(127.0.0.1:3306)/minigameserver?parseTime=true&loc=UTC&charset=utf8mb4"
RANK_SESSION_SECRET=change-me-session-secret
RANK_SERVICE_TOKEN=change-me-service-token
RANK_SESSION_TTL_SEC=86400
RANK_TOPN_DEFAULT=100
RANK_TOPN_MAX=100
RANK_REFRESH_SEC=30
RANK_TZ=UTC

# Auth: comma-separated modes (mock,tiktok). Per-request mode is chosen by channel.
RANK_AUTH_MODE=mock,tiktok
# Optional channel→mode map (defaults: tiktok_minis/douyin→tiktok, others→mock)
RANK_AUTH_CHANNEL_MAP=tiktok_minis:tiktok,douyin:tiktok,weixin:mock

