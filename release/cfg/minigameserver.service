[Unit]
Description=MiniGameServer RankServer
Documentation=file:///opt/minigameserver
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=minigameserver
Group=minigameserver
WorkingDirectory=/opt/minigameserver
EnvironmentFile=/opt/minigameserver/minigameserver.env
ExecStart=/opt/minigameserver/minigameserver
Restart=on-failure
RestartSec=3
LimitNOFILE=65535

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/minigameserver
PrivateTmp=true

[Install]
WantedBy=multi-user.target
