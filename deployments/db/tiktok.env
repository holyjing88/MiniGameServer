# TikTok Minis credentials (server-side OAuth / profile).
# Sourced by deploy-app.sh; synced into process env (release/cfg template → install minigamesvr.env)

# TikTok Developer App ID (platform). Not the same as game business app_id in HTTP body.
RANK_TT_APP_ID=7657847833046812688
RANK_TT_CLIENT_KEY=mg79au52hgl5ggpi
RANK_TT_CLIENT_SECRET=QZAxJCXzGhbK2RWwt3IpXBHN90yNoKto

# Enable auth modes (csv). Channel map selects which mode handles each request.
RANK_AUTH_MODE=mock,tiktok
RANK_AUTH_CHANNEL_MAP=tiktok_minis:tiktok,douyin:tiktok,weixin:mock

# Default game business app_id used by Cocos / login body (optional convenience)
RANK_DEFAULT_APP_ID=parking_smart_brain
