# DB-only config for deployments/db/init-db.sh
# Copy to deployments/db/db.env and edit.
# Defaults match deployments/db/mysql.env (root only).

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Admin: mysql -uroot -pjgyjgyjgy
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=jgyjgyjgy

MYSQL_DATABASE=minigameserver

# When MySQL runs in Compose container named mgs-mysql:
#   ./init-db.sh --docker
MYSQL_DOCKER_CONTAINER=mgs-mysql
