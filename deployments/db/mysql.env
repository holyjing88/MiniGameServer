# Single source of MySQL credentials for all deploy/db scripts.
# Only one account: root

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# mysql -uroot -pjgyjgyjgy
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=jgyjgyjgy

MYSQL_DATABASE=minigameserver
MYSQL_DOCKER_CONTAINER=mgs-mysql

# App DSN (host / native). Compose uses host name "mysql" instead of 127.0.0.1.
RANK_MYSQL_DSN=root:jgyjgyjgy@tcp(127.0.0.1:3306)/minigameserver?parseTime=true&loc=UTC&charset=utf8mb4
