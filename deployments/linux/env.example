# Copy to deployments/linux/.env and edit before production deploy.
# ./deployments/linux/deploy.sh will create .env from this file if missing.
# MySQL: root only — sync with deployments/db/mysql.env

# --- Ports (host) ---
HTTP_PORT=8080
GRPC_PORT=9090
MYSQL_PORT=3306

# --- MySQL (mysql -uroot -pjgyjgyjgy) ---
MYSQL_ROOT_PASSWORD=jgyjgyjgy
MYSQL_DATABASE=minigameserver

# --- RankServer ---
# CHANGE THESE in production
RANK_SESSION_SECRET=change-me-session-secret
RANK_SERVICE_TOKEN=change-me-service-token
RANK_SESSION_TTL_SEC=86400
RANK_TOPN_DEFAULT=100
RANK_TOPN_MAX=100
RANK_REFRESH_SEC=30
RANK_TZ=UTC
RANK_AUTH_MODE=mock

# TikTok OAuth (optional; still mocked until wired)
RANK_TT_CLIENT_KEY=
RANK_TT_CLIENT_SECRET=

# --- Native mode only (/opt/minigameserver) ---
# Used when: ./deploy.sh --native
INSTALL_DIR=/opt/minigameserver
RANK_HTTP_ADDR=:8080
RANK_GRPC_ADDR=:9090
# Host reaches MySQL published on localhost
RANK_MYSQL_DSN=root:jgyjgyjgy@tcp(127.0.0.1:3306)/minigameserver?parseTime=true&loc=UTC&charset=utf8mb4
